          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "null"
            }
          }
        }
      ]
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "parameters",
        "fit_keys_role",
        "state_sha256",
        "reference_input_sha256",
        "reference_output_sha256",
        "input_axis_sha256",
        "output_axis_sha256",
        "input_bands",
        "output_bands",
        "provider",
        "state_unchanged_after_transform"
      ],
      "properties": {
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "$ref": "domains.browser_preprocessing_sensitivity.v1.input#/$defs/parameters"
        },
        "fit_keys_role": {
          "const": "reference_only"
        },
        "state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "reference_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "reference_output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "input_axis_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "output_axis_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "input_bands": {
          "type": "integer",
          "minimum": 1
        },
        "output_bands": {
          "type": "integer",
          "minimum": 1
        },
        "provider": {
          "enum": [
            "1.3.13+abi.2.20.0",
            "1.5.1+abi.2.24.0"
          ]
        },
        "state_unchanged_after_transform": {
