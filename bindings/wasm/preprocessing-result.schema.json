{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domains.browser_preprocessing_sensitivity_result.v1",
  "$comment": "Strict public DTO; no raw X/M arrays or serialized state bytes. Existing scientific report contracts are referenced unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "status",
    "reason",
    "dataset",
    "population",
    "stage",
    "plan",
    "plan_sha256",
    "reference_input_sha256",
    "input_sha256",
    "evidence_sha256",
    "representations",
    "receipt",
    "findings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_version": {
      "const": "domains.browser_preprocessing_sensitivity_result.v1"
    },
    "status": {
      "const": "computed"
    },
    "reason": {
      "type": "null"
    },
    "dataset": {
      "$ref": "domains.browser_scoped_analysis.v1.input#/$defs/dataset"
    },
    "population": {
      "enum": [
        "train",
        "unpartitioned"
      ]
    },
    "stage": {
      "enum": [
        "reference_only",
        "test_audit"
      ]
    },
    "plan": {
      "$ref": "domains.browser_preprocessing_sensitivity.v1.input#/$defs/plan"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "reference_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "representations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/representation"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation",
          "confidence",
          "consequence",
          "action"
        ],
        "properties": {
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "minLength": 1
          },
          "consequence": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "$defs": {
    "representation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "family",
            "steps",
            "status",
            "reason",
            "value"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "family": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "domains.browser_preprocessing_sensitivity.v1.input#/$defs/step"
              },
              "maxItems": 3
            },
            "status": {
              "const": "computed"
            },
            "reason": {
              "type": "null"
            },
            "value": {
              "$ref": "#/$defs/representationValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "family",
            "steps",
            "status",
            "reason",
            "value"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "family": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "domains.browser_preprocessing_sensitivity.v1.input#/$defs/step"
              },
              "maxItems": 3
            },
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "null"
            }
          }
        }
      ]
    },
    "representationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "axis",
        "axis_unit",
        "original_axis_sha256",
        "reference_matrix_sha256",
        "query_matrix_sha256",
        "transformations",
        "structure",
        "factors",
        "support",
        "comparisons"
      ],
      "properties": {
        "source": {
          "$ref": "domains.browser_scoped_analysis.v1.input#/$defs/dataset"
        },
        "axis": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        },
        "axis_unit": {
          "type": "string",
          "minLength": 1
        },
        "original_axis_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "reference_matrix_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "query_matrix_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          ]
        },
        "transformations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformation"
          },
          "maxItems": 3
        },
        "structure": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason",
                "value"
              ],
              "properties": {
                "status": {
                  "const": "computed"
                },
                "reason": {
                  "type": "null"
                },
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "report",
                    "scoped"
                  ],
                  "properties": {
                    "report": {
                      "$ref": "domains.browser_x.v1.report"
                    },
                    "scoped": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "$ref": "domains.browser_scoped_result.v1"
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason",
                "value"
              ],
              "properties": {
                "status": {
                  "const": "unavailable"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "null"
                }
              }
            }
          ]
        },
        "factors": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "domains.browser_factor_association_result.v1"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason",
                  "value"
                ],
                "properties": {
                  "status": {
                    "const": "unavailable"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "null"
                  }
                }
              }
            ]
          },
          "maxItems": 2
        },
        "support": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason",
                "value"
              ],
              "properties": {
                "status": {
                  "const": "computed"
                },
                "reason": {
                  "type": "null"
                },
                "value": {
                  "$ref": "domains.browser_train_fitted_support_result.v1"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason",
                "value"
              ],
              "properties": {
                "status": {
                  "const": "unavailable"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "null"
                }
              }
            }
          ]
        },
        "comparisons": {
          "$ref": "#/$defs/comparisons"
        }
      }
    },
    "comparisons": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pca",
        "neighbors",
        "clusters"
      ],
      "properties": {
        "pca": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "value"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "const": "NO_QUALIFIED_SUBSPACE_COMPARISON_API"
            },
            "value": {
              "type": "null"
            }
          }
        },
        "neighbors": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason",
                "value"
              ],
              "properties": {
                "status": {
                  "const": "computed"
                },
                "reason": {
                  "type": "null"
                },
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "raw_space",
                    "pca_space"
                  ],
                  "properties": {
                    "raw_space": {
                      "$ref": "#/$defs/neighborComparison"
                    },
                    "pca_space": {
                      "$ref": "#/$defs/neighborComparison"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason",
                "value"
              ],
              "properties": {
                "status": {
                  "const": "unavailable"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "null"
                }
              }
            }
          ]
        },
        "clusters": {
          "$ref": "#/$defs/clusterComparison"
        }
      }
    },
    "neighborComparison": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "value"
          ],
          "properties": {
            "status": {
              "const": "computed"
            },
            "reason": {
              "type": "null"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rows",
                "summary",
                "n_reference",
                "n_available",
                "n_unavailable",
                "rule"
              ],
              "properties": {
                "rows": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/neighborRow"
                  },
                  "maxItems": 2000
                },
                "summary": {
                  "$ref": "#/$defs/neighborSummary"
                },
                "n_reference": {
                  "type": "integer",
                  "minimum": 0
                },
                "n_available": {
                  "type": "integer",
                  "minimum": 0
                },
                "n_unavailable": {
                  "type": "integer",
                  "minimum": 0
                },
                "rule": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "value"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "null"
            }
          }
        }
      ]
    },
    "neighborSummary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "value"
          ],
          "properties": {
            "status": {
              "const": "computed"
            },
            "reason": {
              "type": "null"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "count",
                "min",
                "max",
                "mean",
                "sample_sd",
                "q25",
                "median",
                "q75",
                "backend_version"
              ],
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "mean": {
                  "type": "number"
                },
                "sample_sd": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    }
                  ]
                },
                "q25": {
                  "type": "number"
                },
                "median": {
                  "type": "number"
                },
                "q75": {
                  "type": "number"
                },
                "backend_version": {
                  "enum": [
                    "1.3.13+abi.2.20.0",
                    "1.5.1+abi.2.24.0"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "value"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "null"
            }
          }
        }
      ]
    },
    "neighborRow": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "row_key",
            "shared_count",
            "raw_count",
            "representation_count",
            "fraction",
            "reason"
          ],
          "properties": {
            "row_key": {
              "type": "string",
              "minLength": 1
            },
            "shared_count": {
              "type": "integer",
              "minimum": 0
            },
            "raw_count": {
              "type": "integer",
              "minimum": 0
            },
            "representation_count": {
              "type": "integer",
              "minimum": 0
            },
            "fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reason": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "row_key",
            "shared_count",
            "raw_count",
            "representation_count",
            "fraction",
            "reason"
          ],
          "properties": {
            "row_key": {
              "type": "string",
              "minLength": 1
            },
            "shared_count": {
              "type": "integer",
              "minimum": 0
            },
            "raw_count": {
              "type": "integer",
              "minimum": 0
            },
            "representation_count": {
              "type": "integer",
              "minimum": 0
            },
            "fraction": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "clusterComparison": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "value"
          ],
          "properties": {
            "status": {
              "const": "computed"
            },
            "reason": {
              "type": "null"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ari",
                "cluster_jaccard",
                "n_total",
                "n_joint",
                "raw_noise_count",
                "representation_noise_count",
                "both_noise_count",
                "raw_noise_to_assigned_count",
                "raw_assigned_to_noise_count",
                "qualification"
              ],
              "properties": {
                "ari": {
                  "$ref": "#/$defs/ariComparison"
                },
                "cluster_jaccard": {
                  "$ref": "#/$defs/clusterJaccard"
                },
                "n_total": {
                  "type": "integer",
                  "minimum": 0
                },
                "n_joint": {
                  "type": "integer",
                  "minimum": 0
                },
                "raw_noise_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "representation_noise_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "both_noise_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "raw_noise_to_assigned_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "raw_assigned_to_noise_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "qualification": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "value"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "null"
            }
          }
        }
      ]
    },
    "clusterJaccard": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "value"
          ],
          "properties": {
            "status": {
              "const": "computed"
            },
            "reason": {
              "type": "null"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "jaccard",
                "intersections",
                "sizes_a",
                "sizes_b",
                "provider",
                "negative_labels"
              ],
              "properties": {
                "jaccard": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      ]
                    }
                  }
                },
                "intersections": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "sizes_a": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "sizes_b": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "provider": {
                  "enum": [
                    "1.3.13+abi.2.20.0",
                    "1.5.1+abi.2.24.0"
                  ]
                },
                "negative_labels": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "value"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "null"
            }
          }
        }
      ]
    },
    "ariComparison": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "value"
          ],
          "properties": {
            "status": {
              "const": "computed"
            },
            "reason": {
              "type": "null"
            },
            "value": {
              "type": "object",
