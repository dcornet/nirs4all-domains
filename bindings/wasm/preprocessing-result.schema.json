              ],
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "n_joint": {
                  "type": "integer",
                  "minimum": 0
                },
                "provider": {
                  "enum": [
                    "1.3.13+abi.2.20.0",
                    "1.5.1+abi.2.24.0"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "value"
