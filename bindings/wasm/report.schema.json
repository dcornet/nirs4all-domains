{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"domains.browser_x.v1.report",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","protocol_version","engine_version","status","scope","input_sha256","evidence_sha256","metrics","findings","capabilities","test_target_accessed","raw_spectra_included","interpretation","limitations"],
  "properties":{
    "schema_version":{"const":1},
    "protocol_version":{"const":"domains.browser_x.v1"},
    "engine_version":{"type":"string"},
    "status":{"const":"computed"},
    "scope":{"type":"object"},
    "input_sha256":{"$ref":"#/$defs/hash"},
    "evidence_sha256":{"$ref":"#/$defs/hash"},
    "metrics":{
      "type":"object","additionalProperties":false,
      "required":["pca","raw_neighbors","projected_neighbors","density","metadata_factor_association","resampling_stability","parameter_sensitivity","predictive_performance"],
      "properties":{
        "pca":{"$ref":"#/$defs/evidence"},
        "raw_neighbors":{"$ref":"#/$defs/evidence"},
        "projected_neighbors":{"$ref":"#/$defs/evidence"},
        "density":{"$ref":"#/$defs/evidence"},
        "metadata_factor_association":{"$ref":"#/$defs/evidence"},
        "resampling_stability":{"$ref":"#/$defs/evidence"},
        "parameter_sensitivity":{"$ref":"#/$defs/evidence"},
        "predictive_performance":{"$ref":"#/$defs/evidence"}
      }
    },
    "findings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["observation","confidence","consequence","action"],"properties":{"observation":{"type":"string"},"confidence":{"type":"string"},"consequence":{"type":"string"},"action":{"type":"string"}}}},
    "capabilities":{"type":"array","items":{"type":"object"}},
    "test_target_accessed":{"const":false},
    "raw_spectra_included":{"const":false},
    "interpretation":{"type":"object","required":["protocol_version","prediction_intent","declaration_only","evidence_sha256","scope","observation","confidence","consequence","action","readiness","execution","qualification","conditional_scenarios","boundaries"],"properties":{"protocol_version":{"const":"domains.browser_reading.v1"},"declaration_only":{"const":true},"readiness":{"$ref":"#/$defs/evidence"},"execution":{"const":"not_executed"},"conditional_scenarios":{"type":"array"},"boundaries":{"type":"object"}}},
    "limitations":{"type":"array","items":{"type":"string"}}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "evidence":{
      "type":"object","additionalProperties":false,"required":["status","reason","value"],
      "properties":{"status":{"enum":["computed","unavailable","unsupported","error"]},"reason":{"type":["string","null"]},"value":{}},
      "allOf":[{"if":{"properties":{"status":{"const":"computed"}}},"then":{"properties":{"reason":{"type":"null"},"value":{"not":{"type":"null"}}}},"else":{"properties":{"reason":{"type":"string","minLength":1},"value":{"type":"null"}}}}]
    }
  }
}
