{
  "$id": "https://dcornet.github.io/nirs4all-domains/schemas/multifamily-result.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "designs": {
      "additionalProperties": {
        "anyOf": [
          {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "type": "null"
                  },
                  "status": {
                    "enum": [
                      "computed",
                      "exploratory"
                    ]
                  },
                  "value": {
                    "not": {
                      "type": "null"
                    }
                  }
                },
                "required": [
                  "status",
                  "reason",
                  "value"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "inconclusive",
                      "insufficient_information",
                      "not_identifiable",
                      "unavailable",
                      "ineligible",
                      "failed"
                    ]
                  },
                  "value": {
                    "type": "null"
                  }
                },
                "required": [
                  "status",
                  "reason",
                  "value"
                ],
                "type": "object"
              }
            ]
          },
          {
            "additionalProperties": false,
            "properties": {
              "completed_folds": {
                "type": "array"
              },
              "failed_fold_id": {
                "minLength": 1,
                "type": "string"
              },
              "partial_oof_count": {
                "minimum": 0,
                "type": "integer"
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "status": {
                "const": "failed"
              },
              "value": {
                "type": "null"
              }
            },
            "required": [
              "status",
              "reason",
              "value",
              "failed_fold_id",
              "completed_folds",
              "partial_oof_count"
            ],
            "type": "object"
          }
        ]
      },
      "minProperties": 1,
      "type": "object"
    },
    "evaluation_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expected_fit_upper": {
      "minimum": 0,
      "type": "integer"
    },
    "memory": {
      "type": "object"
    },
    "parent_task_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "protocol_version": {
      "const": "domains.multifamily.v0.1"
    },
    "source_fingerprints": {
      "type": "object"
    },
    "specification": {
      "type": "object"
    },
    "task_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "test_target_accessed": {
      "const": false
    },
    "wall_seconds": {
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "protocol_version",
    "task_id",
    "parent_task_id",
    "evaluation_id",
    "specification",
    "designs",
    "wall_seconds",
    "memory",
    "expected_fit_upper",
    "source_fingerprints",
    "test_target_accessed"
  ],
  "type": "object"
}
