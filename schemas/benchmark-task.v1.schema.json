{
  "$id": "https://dcornet.github.io/nirs4all-domains/schemas/benchmark-task.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_version": {
      "minLength": 1,
      "type": "string"
    },
    "dataset_id": {
      "minLength": 1,
      "type": "string"
    },
    "dataset_revision": {
      "minLength": 1,
      "type": "string"
    },
    "independence_policy": {
      "minLength": 1,
      "type": "string"
    },
    "qualification_protocol": {
      "minLength": 1,
      "type": "string"
    },
    "representation": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "source_id": {
      "minLength": 1,
      "type": "string"
    },
    "split_protocol": {
      "minLength": 1,
      "type": "string"
    },
    "target_id": {
      "minLength": 1,
      "type": "string"
    },
    "task_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "dataset_id",
    "content_version",
    "dataset_revision",
    "source_id",
    "target_id",
    "representation",
    "split_protocol",
    "independence_policy",
    "qualification_protocol"
  ],
  "type": "object"
}
