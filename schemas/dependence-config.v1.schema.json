{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded structural dependence configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "seed", "outer_folds", "inner_folds", "max_components", "draws", "factors"],
  "properties": {
    "protocol_version": {"const": "domains.structural_dependence.v0.1"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "outer_folds": {"type": "integer", "minimum": 3, "maximum": 10},
    "inner_folds": {"type": "integer", "minimum": 3, "maximum": 10},
    "max_components": {"type": "integer", "minimum": 1, "maximum": 20},
    "draws": {"type": "integer", "minimum": 0, "maximum": 1000},
    "factors": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["field", "source_column", "provenance", "available_at_prediction"],
        "properties": {
          "field": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"},
          "source_column": {"type": "string", "minLength": 1},
          "provenance": {"type": "string", "minLength": 1},
          "available_at_prediction": {"type": "boolean"}
        }
      }
    }
  }
}
