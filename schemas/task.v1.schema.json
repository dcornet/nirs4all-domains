{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "type": "object",
  "properties": {
    "axis": {
      "type": "array",
      "items": {
        "type": "number",
        "format": "double"
      }
    },
    "axis_unit": {
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/Context"
    },
    "data_origin": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Observation"
      }
    },
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "signal_unit": {
      "type": "string"
    },
    "target_kind": {
      "$ref": "#/$defs/TargetKind",
      "default": "continuous"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context",
    "data_origin",
    "axis",
    "axis_unit",
    "signal_unit",
    "policy",
    "observations"
  ],
  "$defs": {
    "AuditMode": {
      "type": "string",
      "enum": [
        "pre_training",
        "post_evaluation"
      ]
    },
    "Context": {
      "type": "object",
      "properties": {
        "content_version": {
          "type": "string"
        },
        "dataset_id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "split_id": {
          "type": "string"
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "content_version",
        "source_id",
        "split_id"
      ]
    },
    "Observation": {
      "type": "object",
      "properties": {
        "category": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "independence_group": {
          "type": "string"
        },
        "individual_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "observation_id": {
          "type": "string"
        },
        "partition": {
          "$ref": "#/$defs/Partition"
        },
        "physical_sample_id": {
          "type": "string"
        },
        "reference_group_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "reference_id": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "repetition_type": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "sample_id": {
          "type": "string"
        },
        "x": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        },
        "y": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "observation_id",
        "sample_id",
        "physical_sample_id",
        "independence_group",
        "partition",
        "x"
      ]
    },
    "Partition": {
      "type": "string",
      "enum": [
        "train",
        "test"
      ]
    },
    "Policy": {
      "type": "object",
      "properties": {
        "audit_mode": {
          "$ref": "#/$defs/AuditMode",
          "default": "pre_training"
        },
        "independence_unit": {
          "type": "string"
        },
        "pca_max_components": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "pca_variance_fraction": {
          "type": "number",
          "format": "double"
        },
        "seed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "independence_unit",
        "seed",
        "pca_max_components",
        "pca_variance_fraction"
      ]
    },
    "TargetKind": {
      "type": "string",
      "enum": [
        "continuous",
        "categorical"
      ]
    }
  }
}