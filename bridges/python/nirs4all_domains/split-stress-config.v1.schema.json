{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Bounded split stress and training intervention configuration v1",
  "type":"object","additionalProperties":false,
  "required":["protocol_version","seed","outer_folds","inner_folds","max_components","factor","audit_factors","holdout_factors","sensitivity_seeds","shuffle_reference","size_draws","size_max_gap","interventions","intervention_attempts","bootstrap_draws","min_swappable_fraction","min_swappable_components","min_changed_target_fraction"],
  "properties":{
    "protocol_version":{"const":"domains.split_stress.v0.1"},
    "seed":{"const":17},"outer_folds":{"type":"integer","minimum":2,"maximum":5},"inner_folds":{"type":"integer","minimum":3,"maximum":5},
    "max_components":{"type":"integer","minimum":1,"maximum":6},
    "factor":{"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9_]{0,63}$"},
    "audit_factors":{"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9_]{0,63}$"}},
    "holdout_factors":{"type":"array","maxItems":2,"uniqueItems":true,"items":{"type":"string"}},
    "sensitivity_seeds":{"type":"array","maxItems":5,"uniqueItems":true,"items":{"enum":[31,47,61,79,97]}},
    "shuffle_reference":{"type":"boolean"},"size_draws":{"type":"integer","minimum":0,"maximum":3},"size_max_gap":{"type":"integer","minimum":0,"maximum":2},
    "interventions":{"type":"array","maxItems":2,"uniqueItems":true,"items":{"enum":["global","within_factor"]}},
    "intervention_attempts":{"type":"integer","minimum":1,"maximum":19},"bootstrap_draws":{"type":"integer","minimum":0,"maximum":500},
    "min_swappable_fraction":{"type":"number","minimum":0.5,"maximum":1},"min_swappable_components":{"type":"integer","minimum":6},
    "min_changed_target_fraction":{"type":"number","minimum":0.5,"maximum":1}
  }
}
