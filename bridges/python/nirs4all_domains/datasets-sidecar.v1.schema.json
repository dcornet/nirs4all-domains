{
  "$id": "https://dcornet.github.io/nirs4all-domains/schemas/datasets-sidecar.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_version": {
      "minLength": 1,
      "type": "string"
    },
    "dataset_id": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_ref": {
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$",
      "type": "string"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "integration_protocol": {
      "const": "domains.datasets_sidecar.v0.1"
    },
    "purposes": {
      "items": {
        "enum": [
          "candidate_low_structural_dependence",
          "structure_sensitive_challenge",
          "transfer_challenge",
          "insufficient_evidence",
          "not_suitable_for_current_benchmark",
          "within_population_estimator_comparison"
        ]
      },
      "type": "array"
    },
    "qualification_protocol": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "integration_protocol",
    "dataset_id",
    "content_version",
    "task_id",
    "qualification_protocol",
    "evidence_sha256",
    "evidence_ref",
    "purposes"
  ],
  "type": "object"
}
